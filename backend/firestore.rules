rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------
    // Read:  any authenticated user can read any profile (required for
    //        author attribution on article tiles, design D2).
    // Write: only the document owner may create or update their profile
    //        (enforces R2, R3, R4 — server-side identity).
    // Delete: disabled (profiles are soft-deleted via isAnonymous flag).
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // usernames/{username}
    // -----------------------------------------------------------------
    // Create-only: a client may reserve a username document once.
    // No reads, updates, or deletes from the client — username changes
    // are handled server-side via Cloud Functions to maintain the
    // uniqueness invariant (DB_SCHEMA.md §usernames).
    // -----------------------------------------------------------------
    match /usernames/{username} {
      allow create: if request.auth != null;
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
